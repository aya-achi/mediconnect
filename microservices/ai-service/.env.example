# Copy to .env for local (non-Docker) runs.
# Free tier: Groq LLM + local FastEmbed embeddings
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
EMBEDDINGS_PROVIDER=local
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET_KEY=change-me-long-random-string
CORS_ORIGINS=http://localhost:8081
CHROMA_DB_DIR=db_data
FASTEMBED_CACHE_DIR=fastembed_cache
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_FILE_SIZE_MB=10
