# Copy to .env and fill in real values. Never commit .env.

# --- AI providers (free tier by default) ---
# Groq API key (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Optional alternatives: LLM_PROVIDER=gemini|openai|groq (default groq)
#   gemini needs GOOGLE_API_KEY, openai needs OPENAI_API_KEY
GOOGLE_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b  (fallback: openai/gpt-oss-20b)
# EMBEDDINGS_PROVIDER=local|openai (default local = FastEmbed, no API key)

# Shared JWT signing key for monolith + ai-service (use a long random string)
JWT_SECRET_KEY=change-me-long-random-string

# PostgreSQL password
POSTGRES_PASSWORD=change-me
