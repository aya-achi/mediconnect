{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MediConnect.db"
  },
  "Jwt": {
    "Issuer": "MediConnect",
    "Audience": "MediConnectUsers",
    "DurationInMinutes": 60
  },
  "AiService": {
    "Url": "http://localhost:8000"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:8081"
  },
  "AllowedHosts": "*"
}
